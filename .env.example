# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=502XXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com

# Cloudbeds booking engines (public URLs, not API keys)
NEXT_PUBLIC_CLOUDBEDS_MANDALAS_URL=https://hotels.cloudbeds.com/en/reservation/5VReHj?currency=gtq
NEXT_PUBLIC_CLOUDBEDS_HIDEOUT_URL=https://hotels.cloudbeds.com/en/reservation/Uk2zHr?currency=gtq

# Optional privacy-preserving analytics (public project token, never a personal API key)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Cloudbeds server-side API
CLOUDBEDS_API_BASE_URL=https://api.cloudbeds.com/api/v1.3
CLOUDBEDS_HIDEOUT_API_KEY=
CLOUDBEDS_HIDEOUT_PROPERTY_ID=
CLOUDBEDS_MANDALAS_API_KEY=
CLOUDBEDS_MANDALAS_PROPERTY_ID=
CLOUDBEDS_WEBHOOK_SECRET=
CLOUDBEDS_DEBUG_SHAPE=false

# Optional alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature flags
ENABLE_ADMIN=false
ENABLE_GUEST_PORTAL=false
ADMIN_BYPASS_AUTH=false

# Optional legacy modules
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
